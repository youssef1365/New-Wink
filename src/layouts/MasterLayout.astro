---
import SEO from '../components/SEO.astro';
import { seoConfig } from '../utils/seoData';

const { pathname } = Astro.url;
// Get the right data or fall back to default if path isn't found
const metadata = seoConfig[pathname] || seoConfig["default"];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SEO
      title={metadata.title}
      description={metadata.description}
      url={`https://wink-consulting.com${pathname}`}
    />
  </head>
  <body>
    <slot />
  </body>
</html>